      "destination": "/"
    },
    {
      "source": "/studio",
      "destination": "/"
    },
    {
      "source": "/resources/business-website-cost",
      "destination": "/"
    },
    {
      "source": "/work/ceylon-gem-atelier",
      "destination": "/"
    },
